# =============================================================================
# Kosha environment configuration
# =============================================================================
#
# Copy this file to `.env` in the project root and adjust the values:
#
#     cp .env.example .env
#
# How values are resolved:
#   - Real environment variables always win over values in `.env`.
#   - Anything left unset falls back to the default shown below.
#   - Lines starting with `#` are comments. Uncomment a line to set it.
#
# Value formats:
#   - Booleans accept: true/false, yes/no, on/off, 1/0 (case-insensitive).
#   - Lists are comma-separated with no spaces: a.com,b.com
#   - Never commit `.env`. It holds secrets and is already git-ignored.
#
# Defaults are production-safe. The minimum for a production deploy is
# SECRET_KEY, ALLOWED_HOSTS, DATABASE_URL, WEBAUTHN_ORIGINS (or an https://
# CSRF_TRUSTED_ORIGINS) and the four required S3_* values.
# For local development, set DEBUG=true, SECRET_KEY to anything and
# DATABASE_URL to a local Postgres (host.docker.internal from the Docker
# development stack).


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# DEBUG
#   Enables detailed error pages, auto-reloading and relaxed security.
#   Turning it on also flips several defaults below to development-friendly
#   values (ALLOWED_HOSTS, SECURE_HTTPS, EMAIL_PORT, EMAIL_USE_TLS) and makes
#   the S3_* media settings optional.
#   NEVER enable in production: error pages leak settings, source code and
#   request data.
#   Default: false
DEBUG=false

# SECRET_KEY (required, no default)
#   Signs sessions, password reset tokens, CSRF tokens and anything else
#   Django signs. Must be long, random and kept secret. Changing it logs
#   everyone out and invalidates outstanding password reset links.
#   Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ALLOWED_HOSTS
#   Comma-separated host names this site may be served under. Requests with
#   any other Host header are rejected (protects against host header attacks).
#   A leading dot matches a domain and all its subdomains: .example.com
#   Do not include scheme or port.
#   Default: localhost,127.0.0.1,[::1] when DEBUG=true; empty otherwise
#   (an empty list rejects every request, so this must be set in production).
#ALLOWED_HOSTS=kosha.example.com

# CSRF_TRUSTED_ORIGINS
#   Comma-separated origins allowed to submit unsafe (POST, PUT, ...) requests
#   when the origin differs from the Host header, e.g. when served behind a
#   reverse proxy on a different port or domain. Must include the scheme.
#   Wildcards are allowed for subdomains: https://*.example.com
#   Default: empty
#CSRF_TRUSTED_ORIGINS=https://kosha.example.com

# WEBAUTHN_ORIGINS (required in production unless CSRF_TRUSTED_ORIGINS has an
# https:// entry)
#   Comma-separated origins a Passkey may be used from: scheme, host and any
#   port, such as the public URL Kosha is served on. Each must be HTTPS
#   (http://localhost is allowed for development) and on WEBAUTHN_RP_ID's
#   host or a subdomain of it.
#   Default: the https:// entries of CSRF_TRUSTED_ORIGINS without wildcards;
#   else http://localhost:8000 when DEBUG=true; none otherwise
#WEBAUTHN_ORIGINS=https://kosha.example.com

# WEBAUTHN_RP_ID
#   The domain Passkeys are bound to (the relying party ID): a bare host, no
#   scheme or port. Changing it later orphans every Passkey already added, so
#   settle it before Claiming the install.
#   Default: the host of the first WEBAUTHN_ORIGINS entry
#WEBAUTHN_RP_ID=kosha.example.com

# ADMIN_URL
#   URL prefix for the Django admin. Moving it off the well-known `admin/`
#   cuts down on automated login attempts. Must end with a slash and must not
#   start with one.
#   Default: admin/
#ADMIN_URL=admin/


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# DATABASE_URL (required, no default)
#   PostgreSQL connection as a URL, used in both development and production:
#     postgres://USER:PASSWORD@HOST:PORT/NAME
#   URL-encode special characters in the password (e.g. @ becomes %40).
#   Extra driver options can be passed as query parameters, e.g.
#     postgres://user:pass@host:5432/kosha?sslmode=require
DATABASE_URL=postgres://kosha:kosha@localhost:5432/kosha

# CONN_MAX_AGE
#   Seconds to keep a database connection open for reuse between requests.
#   0 closes the connection after every request. Reusing connections avoids
#   the overhead of reconnecting; stale connections are health-checked before
#   reuse. Keep it below your database server's idle timeout.
#   Default: 60
#CONN_MAX_AGE=60


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

# CACHE_URL
#   Cache backend as a URL. Supported formats:
#     Local memory: locmemcache://         (per-process, not shared between
#                                           gunicorn workers)
#     Redis:        redis://HOST:PORT/DB    (requires `uv add redis`)
#                   rediss://...            (Redis over TLS)
#     Database:     dbcache://TABLE_NAME    (run `manage.py createcachetable`)
#     Filesystem:   filecache:///absolute/path
#     Disabled:     dummycache://
#   Use a shared cache (Redis) once you run more than one process and rely on
#   the cache for anything that must be consistent, such as rate limiting.
#   Default: locmemcache://
#CACHE_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# HTTPS and security
# -----------------------------------------------------------------------------

# SECURE_HTTPS
#   Master switch for running over HTTPS. When true:
#     - plain HTTP requests are redirected to HTTPS
#     - session and CSRF cookies are only sent over HTTPS
#     - HSTS is enabled (see SECURE_HSTS_SECONDS)
#   Set to false only when serving over plain HTTP on a trusted network
#   (e.g. a home LAN with no TLS). Logins over plain HTTP expose passwords
#   to anyone on the network.
#   Default: true, or false when DEBUG=true
#SECURE_HTTPS=true

# SECURE_PROXY_SSL_HEADER
#   Set to true when running behind a reverse proxy (nginx, Caddy, Traefik,
#   a load balancer) that terminates TLS and forwards requests over HTTP.
#   Django then trusts the `X-Forwarded-Proto: https` header to know the
#   original request was secure. Without this, SECURE_HTTPS behind such a
#   proxy causes an infinite redirect loop.
#   Only enable if the proxy always sets or strips this header; otherwise
#   clients can spoof it.
#   Default: false
#SECURE_PROXY_SSL_HEADER=false

# USE_X_FORWARDED_FOR
#   Set to true when running behind a reverse proxy, so Kosha takes each
#   client's address from the last entry of the X-Forwarded-For header (the
#   one the proxy adds) instead of the proxy's own address. Addresses are
#   what a Pause (an hour without signing in after 5 wrong passwords or
#   codes) applies to and what the Security log records; left off behind a
#   proxy, one stranger's wrong tries would Pause everyone.
#   Only enable behind a proxy that always adds this header; without one,
#   clients could pick their own address and escape a Pause.
#   Default: false
#USE_X_FORWARDED_FOR=false

# SECURE_HSTS_SECONDS
#   How long browsers should remember to only use HTTPS for this site
#   (Strict-Transport-Security header). Once a browser has seen it, the site
#   is unreachable over plain HTTP for that duration, even if you later turn
#   HTTPS off. When first deploying, consider starting low (e.g. 3600) and
#   raising it once HTTPS is confirmed working. 0 disables HSTS.
#   Default: 31536000 (one year) when SECURE_HTTPS is true; 0 otherwise
#SECURE_HSTS_SECONDS=31536000

# SECURE_HSTS_INCLUDE_SUBDOMAINS
#   Extends HSTS to every subdomain of this host. Only enable if every
#   subdomain is served exclusively over HTTPS.
#   Default: false
#SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# SECURE_HSTS_PRELOAD
#   Adds the `preload` directive so the domain can be submitted to browsers'
#   built-in HSTS list (https://hstspreload.org). Requires
#   SECURE_HSTS_INCLUDE_SUBDOMAINS=true and SECURE_HSTS_SECONDS>=31536000.
#   Preloading is very hard to undo.
#   Default: false
#SECURE_HSTS_PRELOAD=false


# -----------------------------------------------------------------------------
# Internationalization
# -----------------------------------------------------------------------------

# LANGUAGE_CODE
#   Default language for the site, as a language tag.
#   Default: en-us
#LANGUAGE_CODE=en-us

# TIME_ZONE
#   Time zone used to display dates and times, as an IANA name
#   (e.g. Asia/Kolkata, Europe/London). Values are always stored in UTC in
#   the database regardless of this setting.
#   Default: UTC
#TIME_ZONE=UTC


# -----------------------------------------------------------------------------
# Static and media files
# -----------------------------------------------------------------------------

# STATIC_ROOT
#   Directory `manage.py collectstatic` copies static files (CSS, JS, images)
#   into. They are served from here by WhiteNoise, so no separate web server
#   is needed for static files.
#   Relative paths resolve against the project root.
#   Default: staticfiles
#STATIC_ROOT=staticfiles

# MEDIA_ROOT
#   Directory for user-uploaded files when no S3 bucket is configured, which
#   is only allowed with DEBUG=true. Production stores media in R2 instead
#   (see below).
#   Relative paths resolve against the project root.
#   Default: media
#MEDIA_ROOT=media


# -----------------------------------------------------------------------------
# Media storage (Cloudflare R2)
# -----------------------------------------------------------------------------

# Uploaded files live in a private R2 bucket and are only ever served through
# short-lived signed URLs. See docs/adr/0001-media-in-a-private-r2-bucket.md.
# With DEBUG=false the four settings below are required and Django refuses to
# start without them. With DEBUG=true they are optional; leave
# S3_BUCKET_NAME unset to use MEDIA_ROOT on the local filesystem.
# Create an R2 API token with Object Read & Write on the bucket only.

# S3_BUCKET_NAME (required in production)
#   Name of the private R2 bucket. Do not enable public access on it.
#S3_BUCKET_NAME=kosha-media

# S3_ENDPOINT_URL (required in production)
#   The account's S3 API endpoint, without the bucket name:
#     https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# S3_ACCESS_KEY_ID (required in production)
#   Access key id of the R2 API token.
#S3_ACCESS_KEY_ID=

# S3_SECRET_ACCESS_KEY (required in production)
#   Secret access key of the R2 API token.
#S3_SECRET_ACCESS_KEY=

# S3_QUERYSTRING_EXPIRE
#   Seconds a signed URL to an uploaded file stays valid.
#   Default: 300
#S3_QUERYSTRING_EXPIRE=300


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# All email is sent over SMTP. In development, run Mailpit
# (https://mailpit.axllent.org) locally: it accepts mail on localhost:1025 and
# shows it in a web inbox at http://localhost:8025. With DEBUG=true the
# defaults below already point at it, so no email settings are needed.
# In production, point these at a real SMTP provider.

# EMAIL_HOST
#   SMTP server host name.
#   Default: localhost
#EMAIL_HOST=smtp.example.com

# EMAIL_PORT
#   SMTP server port. Usually 587 for STARTTLS, 465 for implicit TLS
#   (SSL), 1025 for Mailpit.
#   Default: 1025 when DEBUG=true (Mailpit); 587 otherwise
#EMAIL_PORT=587

# EMAIL_HOST_USER
#   SMTP username. Leave empty if the server needs no authentication
#   (Mailpit needs none).
#   Default: empty
#EMAIL_HOST_USER=

# EMAIL_HOST_PASSWORD
#   SMTP password.
#   Default: empty
#EMAIL_HOST_PASSWORD=

# EMAIL_USE_TLS
#   Upgrade the connection with STARTTLS (typically port 587).
#   Mutually exclusive with EMAIL_USE_SSL.
#   Default: false when DEBUG=true or EMAIL_USE_SSL=true; true otherwise
#EMAIL_USE_TLS=true

# EMAIL_USE_SSL
#   Connect over implicit TLS from the start (typically port 465).
#   Enabling this turns EMAIL_USE_TLS off by default.
#   Default: false
#EMAIL_USE_SSL=false

# EMAIL_TIMEOUT
#   Seconds to wait for the SMTP server before giving up, so a slow mail
#   server can't hang a request indefinitely.
#   Default: 10
#EMAIL_TIMEOUT=10

# DEFAULT_FROM_EMAIL
#   Sender address for emails to users (password resets, notifications).
#   Accepts a bare address or "Name <address>".
#   Default: webmaster@localhost
#DEFAULT_FROM_EMAIL=Kosha <kosha@example.com>

# SERVER_EMAIL
#   Sender address for error reports sent to ADMINS. Many SMTP providers
#   reject mail from unverified senders, so use an address on your domain.
#   Default: same as DEFAULT_FROM_EMAIL
#SERVER_EMAIL=kosha-errors@example.com

# EMAIL_SUBJECT_PREFIX
#   Prefix added to the subject of emails sent to ADMINS and MANAGERS.
#   Default: "[Kosha] "
#EMAIL_SUBJECT_PREFIX="[Kosha] "

# ADMINS
#   Comma-separated email addresses that receive a report for every unhandled
#   server error (HTTP 500) when DEBUG=false. Also used as MANAGERS, who
#   receive broken-link reports. Requires a working SMTP server.
#   Default: empty (no error emails)
#ADMINS=you@example.com,ops@example.com


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# LOG_LEVEL
#   Minimum level of log messages written to the console (stderr), for both
#   Django's own loggers and the app's.
#   One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
#   Default: INFO
#LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Gunicorn (read by docker/gunicorn.conf.py in the production image)
# -----------------------------------------------------------------------------

# GUNICORN_WORKERS
#   Number of worker processes. Each worker holds a copy of the app in memory.
#   Default: 2
#GUNICORN_WORKERS=2

# GUNICORN_THREADS
#   Threads per worker. Every thread can hold its own database connection, so
#   keep WORKERS x THREADS below your Postgres max_connections.
#   Default: 4
#GUNICORN_THREADS=4

# GUNICORN_TIMEOUT
#   Seconds a request may run before its worker is killed and restarted.
#   Default: 30
#GUNICORN_TIMEOUT=30

# GUNICORN_GRACEFUL_TIMEOUT
#   Seconds workers get to finish in-flight requests on shutdown. Must stay
#   below the compose file's stop_grace_period (45s).
#   Default: 30
#GUNICORN_GRACEFUL_TIMEOUT=30

# GUNICORN_KEEPALIVE
#   Seconds to hold an idle keep-alive connection open.
#   Default: 5
#GUNICORN_KEEPALIVE=5

# GUNICORN_MAX_REQUESTS
#   Requests a worker serves before it is replaced, which bounds memory
#   growth. 0 disables recycling.
#   Default: 1000
#GUNICORN_MAX_REQUESTS=1000

# GUNICORN_MAX_REQUESTS_JITTER
#   Random extra requests per worker, so workers do not all restart at once.
#   Default: 100
#GUNICORN_MAX_REQUESTS_JITTER=100

# GUNICORN_PRELOAD
#   Load the app once before forking workers, sharing its memory between them.
#   Default: true
#GUNICORN_PRELOAD=true

# GUNICORN_LOG_LEVEL
#   One of: debug, info, warning, error, critical.
#   Default: info
#GUNICORN_LOG_LEVEL=info

# GUNICORN_FORWARDED_ALLOW_IPS
#   Peers allowed to set X-Forwarded-* headers. The default trusts any peer,
#   which is safe only because compose.prod.yaml publishes the port on
#   127.0.0.1. Narrow it if you publish the port anywhere else.
#   Default: *
#GUNICORN_FORWARDED_ALLOW_IPS=*


# -----------------------------------------------------------------------------
# Docker (read by compose, not by Django)
# -----------------------------------------------------------------------------

# KOSHA_VERSION (compose.prod.yaml)
#   Image tag to run: an exact version (1.2.3), a minor line (1.2) that picks
#   up patch releases, or latest, which tracks the newest stable release and
#   never a prerelease. Upgrading is changing this and running `up -d`.
#   Default: latest
#KOSHA_VERSION=latest

# DOCKER_HOST_PORT
#   Host port the app is published on. Production binds it to 127.0.0.1 only,
#   for your reverse proxy to forward to.
#   Default: 8000
#DOCKER_HOST_PORT=8000

# DOCKER_CPU_LIMIT, DOCKER_MEMORY_LIMIT (compose.prod.yaml)
#   Ceilings for the app container, so a runaway worker cannot starve the host.
#   Default: 2.0 and 1g
#DOCKER_CPU_LIMIT=2.0
#DOCKER_MEMORY_LIMIT=1g

# DOCKER_LOG_MAX_SIZE, DOCKER_LOG_MAX_FILE (compose.prod.yaml)
#   Container log rotation: size of each file and how many are kept.
#   Default: 10m and 3
#DOCKER_LOG_MAX_SIZE=10m
#DOCKER_LOG_MAX_FILE=3

# DOCKER_UID, DOCKER_GID (compose.yaml)
#   Your user and group id (`id -u`, `id -g`). The development containers run
#   as them so files they write into the working tree stay yours.
#   Default: 1000
#DOCKER_UID=1000
#DOCKER_GID=1000
